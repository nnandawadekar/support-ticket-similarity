  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Proposed sidebar sends subject + description to POST /similar",
        "Service preserves retrieval order, filters by weak threshold, and limits to top_k",
        "Verdict describes the first displayed match; nearest is that match, or the top raw candidate when abstaining"
      ]
    },
    {
      "dot": "emerald",
      "title": "Scoring",
      "items": [
        "BM25F weights: subject 3.0, tags 2.0, description 1.0, resolution 0.4",
        "Coverage is a heuristic, not a probability that the fix transfers",
        "Hybrid: RRF (k=60); confidence averages coverage and nonnegative cosine; missing top-50 signals contribute zero"
      ]
    },
    {
      "dot": "rose",
      "title": "Input validation",
      "items": [
        "API rejects malformed JSON, field types and top_k outside 1-20 with status 400",
        "Batch field validation precedes indexing; owned copies protect indexed IDs and fixes from caller mutation",
        "Integer IDs, including zero, normalize to strings; duplicate IDs are indexed once"
      ]
    },
    {
      "dot": "amber",
      "title": "Verdict thresholds",
      "items": [
        "Initial lexical: strong >= 0.45, weak >= 0.20; hybrid: strong >= 0.55, weak >= 0.35",
        "Weak threshold sweep is in-sample analysis; it neither changes defaults nor calibrates strong",
        "Both modes abstain on 7/8 no-fix queries; NT-1 remains a weak false acceptance"
      ]
    },
    {
      "dot": "violet",
      "title": "Measured scale",
      "items": [
        "Sequential lexical p95: 76.6 ms at 55k and 243.4 ms at 165k; synthetic data, not a guaranteed worst case",
        "Peak traced build allocation at 165k: 1461 MB; not total RSS. Hybrid scale and burst capacity are unverified",
        "Planning envelope: 55k backlog + 165k incoming. Migrate to persisted search before approaching 165k retained tickets"
      ]
    },
    {
      "dot": "slate",
      "title": "Not built yet",
      "items": [
        "Helpdesk sidebar app and webhooks are the proposed integration",
        "Index is rebuilt from JSON at startup; POST /tickets is not persisted",
        "No auth or rate limiting on the API; PII is not scrubbed"
      ]
    }
  ]
}
