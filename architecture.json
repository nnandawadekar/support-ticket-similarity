  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Agent opens ticket → POST /similar with subject + description",
        "Service ranks candidates, filters at the weak threshold, returns verdict + matches + nearest",
        "Each match carries resolution notes, matched terms and per-signal scores"
      ]
    },
    {
      "dot": "emerald",
      "title": "Scoring",
      "items": [
        "BM25F field weights: subject 3.0, tags 2.0, description 1.0, resolution 0.4",
        "Confidence = IDF-weighted query coverage; unseen terms get max IDF",
        "Hybrid: RRF (k=60) over both rankings; confidence = mean(coverage, cosine)"
      ]
    },
    {
      "dot": "rose",
      "title": "Input validation",
      "items": [
        "API rejects malformed bodies with 400: non-object JSON, bad Content-Length, wrong field types, top_k outside 1–20",
        "Each ticket is fully validated before any index is written, so a bad ticket can't shift ticket and index positions",
        "Integer ticket IDs (as Zendesk uses) are accepted and normalised to strings; duplicates in one batch are indexed once"
      ]
    },
    {
      "dot": "amber",
      "title": "Verdict thresholds",
      "items": [
        "lexical: strong ≥ 0.45, weak ≥ 0.20",
        "hybrid: strong ≥ 0.55, weak ≥ 0.35",
        "Below weak → no_match; nearest is returned but never shown as a match"
      ]
    },
    {
      "dot": "violet",
      "title": "Measured scale",
      "items": [
        "Lexical p95: 74 ms @ 55k, 232 ms @ 165k tickets (synthetic worst case)",
        "Dense: 4.4 ms matvec @ 165k; query encode 3.8 ms on CPU",
        "Beyond ~165k: Postgres FTS / OpenSearch + pgvector behind SimilarityService"
      ]
    },
    {
      "dot": "slate",
      "title": "Not built yet",
      "items": [
        "Helpdesk sidebar app and webhooks are the proposed integration",
        "Index is rebuilt from JSON at startup; POST /tickets is not persisted",
        "No auth or rate limiting on the API; PII is not scrubbed"
      ]
    }
  ]
